# 复制为 .env 后按需修改；docker compose 会自动读取。
#   cp .env.example .env

# 对外端口（宿主机侧）
APP_PORT=8080

# 数据库口令（同时用于 app → db 的连接串）
POSTGRES_PASSWORD=tangxiaoshi

# 镜像：默认本地构建并打 tag tangxiaoshi:local；
# 在服务器上用 CI 产物时改成 ghcr.io/liujuntao123/tangxiaoshi:latest
# APP_IMAGE=ghcr.io/liujuntao123/tangxiaoshi:latest

# 对外访问地址（挂了域名/反代时必填，末尾不带斜杠）
# BETTER_AUTH_URL=https://tangxiaoshi.example.com

# 会话签名密钥（生产必填，否则每次重启都要重新登录）：
#   docker compose exec app node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# 额外信任来源，逗号分隔；与 BETTER_AUTH_URL 的域名保持一致即可
# BETTER_AUTH_TRUSTED_ORIGINS=https://tangxiaoshi.example.com
